datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int       @id @default(autoincrement())
  name       String
  isAdmin    Boolean   @default(false) @map("is_admin")
  password   String
  reputation Int       @default(0)
  posts      Post[]    @relation("PostUsers")
  comments   Comment[]
  supports   Post[]

  @@map("users")
}

model Post {
  id         Int       @id @default(autoincrement())
  title      String
  body       String
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id])
  comments   Comment[]
  supporters User[]    @relation("PostUsers")
  score      Int       @default(0)

  @@map("posts")
}

model Comment {
  id     Int    @id @default(autoincrement())
  body   String
  userId Int    @map("user_id")
  postId Int    @map("post_id")
  post   Post   @relation(fields: [postId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("comments")
}

model Hadith {
  id   Int    @id @default(autoincrement())
  text String @db.Text

  @@map("hadiths")
}

model Book {
  id      Int      @id @default(autoincrement())
  name    String
  author  String
  price   Float
  bundles Bundle[] @relation("book_bundles")

  @@map("books")
}

model Bundle {
  id            Int      @id @default(autoincrement())
  name          String
  price         Float
  books         Book[]   @relation("book_bundles")
  bundles       Bundle[] @relation("nested_bundles")
  parentBundles Bundle[] @relation("nested_bundles")

  @@map("bundles")
}
